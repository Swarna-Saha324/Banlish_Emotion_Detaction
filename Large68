ts = [0.10, 0.20, 0.30]\n\n    results = []\n    for lr in lrs:\n        for dropout in dropouts:\n            cfg = {\"model_name\": model_name, \"max_len\": max_len, \"loss_type\": loss_type,\n                   \"base_lr\": lr, \"dropout\": dropout}\n            print(f\"\\n--- lr={lr}, dropout={dropout} ---\")\n            val_metrics, _, _ = run_experiment(X_train, y_train, X_val, y_val, X_test, y_test,\n                                                cfg, num_epochs=5, skip_test=True, batch_size=batch_size)\n            print(f\"  Val Macro F1: {val_metrics['macro_f1']:.4f}\")\n            results.append({\"lr\": lr, \"dropout\": dropout, **val_metrics})\n\n    results.sort(key=lambda r: r[\"macro_f1\"], reverse=True)\n    print(\"\\n===== Top 5 =====\")\n    for r in results[:5]:\n        print(f\"  lr={r['lr']}, dropout={r['dropout']}: Val Macro F1={r['macro_f1']:.4f}\")\n\n    with open(\"stage4_expanded_search.json\", \"w\") as f:\n        json.dump(results, f, indent=2)\n    return results[0]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-26T04:25:48.915768Z","iopub.execute_input":"2026-07-26T04:25:48.91648Z","iopub.status.idle":"2026-07-26T04:25:48.923075Z","shell.execute_reply.started":"2026-07-26T04:25:48.916448Z","shell.execute_reply":"2026-07-26T04:25:48.922334Z"}},"outputs":[],"execution_count":10},{"cell_type":"code","source":"# MAIN — runs all stages in sequence, then ONE final test run\n# =========================================================\nif __name__ == \"__main__\":\n    set_seed(42)\n    X_train, y_train, X_val, y_val, X_test, y_test = load_and_split_data()\n\n    best_model_name = stage1_model_size(X_train, y_train, X_val, y_val, X_test, y_test)\n    best_max_len = stage2_max_len(X_train, y_train, X_val, y_val, X_test, y_test, best_model_name)\n    best_loss_type = stage3_loss_comparison(X_train, y_train, X_val, y_val, X_test, y_test,\n                                             best_model_name, best_max_len)\n 